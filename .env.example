# Copy to .env and fill in for LLM-based intent parsing.
# Without this, the agent automatically falls back to a deterministic
# regex/keyword intent parser -- the system degrades gracefully rather
# than failing, which matters for a production banking tool.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for NL intent extraction (fast/cheap tier is sufficient here)
AML_INTENT_MODEL=claude-haiku-4-5-20251001

# Optional: override SQLite DB path
AML_DB_PATH=./aml.db

# Frontend -> backend URL
AML_API_URL=http://127.0.0.1:8000
